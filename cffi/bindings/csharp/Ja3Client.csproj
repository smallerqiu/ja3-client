<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 is the floor: the binding uses NativeLibrary (Core 3.0+), required
         members and records (C# 11). Retarget freely; nothing here is net9-only. -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Ja3Client</RootNamespace>
    <AssemblyName>ja3-client-ffi</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>NU1701</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The package id matches npm and PyPI: one name, three registries, and the
         version is the library version (build/ja3-client.targets fetches the release
         archive for it). CI stamps Version from the git tag. -->
    <PackageId>ja3-client</PackageId>
    <Version>1.2.5</Version>
    <Authors>smallerqiu</Authors>
    <Description>P-Invoke binding for the ja3-client TLS-impersonation shared library. The package ships the binding; the native library is fetched from the matching GitHub Release at build time.</Description>
    <PackageTags>ja3;ja4;tls;impersonate;fingerprint;ffi;pinvoke</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/smallerqiu/ja3-client</PackageProjectUrl>
    <RepositoryUrl>https://github.com/smallerqiu/ja3-client</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>false</IncludeSymbols>
    <IncludeSource>false</IncludeSource>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="example/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shipped inside the nupkg: NuGet imports build/*Targets.props/.targets into the
         consuming project, which is where the native library gets resolved and copied
         to the output directory. The path has to be the package-local one, so the
         physical folder is also called build/. -->
    <None Include="build/ja3-client.targets" Pack="true" PackagePath="build/" />
    <None Include="README.md" Pack="true" PackagePath="/" Condition="Exists('README.md')" />
    <None Include="LICENSE" Pack="true" PackagePath="/" Condition="Exists('LICENSE')" />
  </ItemGroup>

</Project>
