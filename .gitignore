cffi/bindings/csharp/example/obj/
cffi/bindings/python/__pycache__/
cffi/dist/

# `go build ./...` inside cffi/ drops the plain executable of the c-shared
# package next to it. Only the -buildmode output is the library; this file is
# the same code built as a program that does nothing.
cffi/cffi

