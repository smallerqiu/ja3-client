.idea
.vscode/
__pycache__
.mypy_cache/
cffi/build/

# Local co-development with the sibling ../ja3-utls checkout.
# Never commit this: consumers must resolve github.com/smallerqiu/utls from
# go.mod's published version, and go.work would silently override that locally.
go.work
go.work.sum

# FFI build output and binding deps
cffi/bindings/node/node_modules/
cffi/bindings/node/package-lock.json
cffi/bindings/csharp/example/bin/
cffi/bindings/csharp/example/obj/
cffi/bindings/python/__pycache__/
cffi/dist/

# `go build ./...` inside cffi/ drops the plain executable of the c-shared
# package next to it. Only the -buildmode output is the library; this file is
# the same code built as a program that does nothing.
cffi/cffi

.DS_Store

# Local browser captures used to build the profiles (chrome 142-155 ja4/ja3/peet
# dumps). They are someone's machine and network fingerprint: keep them out of
# the repository and out of any release archive.
client_data/
data_peet/

# `pip wheel .` / `python -m build` output next to the sources.
cffi/bindings/python/build/
cffi/bindings/python/*.egg-info/

# `dotnet pack` output for the binding project itself. csharp/build/ is NOT output -
# that is the NuGet content directory holding ja3-client.targets.
cffi/bindings/csharp/bin/
cffi/bindings/csharp/obj/
